# Copy to .env and adjust. Used by docker-compose.yml.

# Required: HS256 signing key for access tokens, at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional: enables Claude-powered natural-language search.
# Without it, the rule-based query parser is used.
ANTHROPIC_API_KEY=

POSTGRES_PASSWORD=easyrenting

# "prod,demo" seeds demo accounts and ~60 listings on first start; use "prod" for an empty database.
SPRING_PROFILES_ACTIVE=prod,demo

# Public URLs as seen by the browser.
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8080/ws

# Set to true when served over HTTPS.(OPtional)
COOKIE_SECURE=false
