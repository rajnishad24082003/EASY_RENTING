# Origin of the Spring Boot backend. Used by Next.js rewrites (/api/* -> $BACKEND_URL/api/*)
# and for server-side metadata fetches. Baked in at build time for standalone builds.
BACKEND_URL=http://localhost:8080

# WebSocket (STOMP) endpoint the browser connects to directly.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
