=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeColor=none;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="44" y="132" width="392" height="171" as="geometry"/></mxCell><mxCell id="c7" value="notifications" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="400" height="224" as="geometry"/></mxCell><mxCell id="c8" value="&lt;table style='width:100%;font-size:11px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;PK&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;FK&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;user_id&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;→ users ON DELETE CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;type&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;VISIT_* | VERIFICATION_*&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;title&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;varchar(160)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;body&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;varchar(500)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;link&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;varchar(255) frontend route&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;read&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;boolean&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;created_at / updated_at&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;hr style='margin:4px 0'&gt;&lt;div style='font-size:10px;color:#444;text-align:left'&gt;ix_notifications_user (user_id, created_at DESC)&lt;br&gt;ix_notifications_unread (user_id) WHERE read = false&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeColor=none;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="44" y="452" width="392" height="188" as="geometry"/></mxCell><mxCell id="c9" value="verification_documents" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="400" height="210" as="geometry"/></mxCell><mxCell id="c10" value="&lt;table style='width:100%;font-size:11px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;PK&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;FK&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;owner_id&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;→ users ON DELETE CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;document_type&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;AADHAAR|PAN|PASSPORT|…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;file_name&lt;/b&gt;&lt;/td&gt;&lt;td style='paddin