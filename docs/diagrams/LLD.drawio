arcSize=40;" vertex="1" parent="1"><mxGeometry x="150" y="792" width="220" height="50" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;REVOKED (rotated)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="520" y="792" width="220" height="50" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;EXPIRED (30 d)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="150" y="920" width="220" height="50" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;FAMILY REVOKED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="880" y="792" width="220" height="50" as="geometry"/></mxCell><mxCell id="c51" value="login / register" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="used once by /refresh&lt;br&gt;→ child token issued" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="time" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c47" target="c49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="presented again&lt;br&gt;(reuse = theft)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c48" target="c50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="9. Frontend Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;Frontend (Next.js 16 App Router): routes → features → lib layers&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;Routes stay thin; domain logic lives in src/features/&lt;domain&gt;; cross-cutting infrastructure in src/lib&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2320" height="60" as="geometry"/></mxCell><mxCell id="c3" value="src/app: routes" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="820" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;(marketing): header + footer&lt;/b&gt;&lt;br&gt;/  landing + AI hero search&lt;br&gt;/properties/[id]  detail (SSR title)&lt;br&gt;/login · /register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="145" width="520" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;(app): header only&lt;/b&gt;&lt;br&gt;/search  filters + list + map&lt;br&gt;/messages · /messages/[id]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="520" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;/dashboard  (RequireAuth)&lt;/b&gt;&lt;br&gt;/dashboard → role redirect&lt;br&gt;/dashboard/visits  (tenant &amp; owner)&lt;br&gt;/dashboard/shortlist  (tenant)&lt;br&gt;/dashboard/listings · /new · /[id]/edit  (owner)&lt;br&gt;/dashboard/verification  (owner)&lt;br&gt;/dashboard/profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="335" width="520" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;/admin  (ADMIN)&lt;/b&gt;&lt;br&gt;/admin  overview stats&lt;br&gt;/admin/verifications&lt;br&gt;/admin/users&lt;br&gt;/admin/listings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="520" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;special&lt;/b&gt;&lt;br&gt;not-found.tsx · error.tsx · loading.tsx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="625" width="520" height="50" as="geometry"/></mxCell><mxCell id="c9" value="src/features: domain modules (components · hooks · query keys)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="1000" height="820" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;search&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;hero-search · ai-search-bar · ai-search-summary · filter-panel · locality-autocomplete · search-map · search-view · featured-listings · filters.ts (URL ⇄ filters)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="145" width="470" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;properties&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;listing-card · property-detail-view · property-gallery · property-action-panel · amenity-icon · status-badge&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="145" width="470" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;listings&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;listing-wizard · listing-steps · photo-manager · my-listings-view · edit-listing · schema.ts (zod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="295" width="470" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;visits&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;schedule-visit-form · time-slot-picker · slots.ts (IST slots) · visit-card · visit-action-dialogs · visits-view&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="295" width="470" height="130" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;chat&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;messages-shell · conversation-list · chat-thread (role=log) · message-bubble · message-composer · cache.ts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="445" width="470" height="130" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;notifications&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;notification-bell (dropdown, mark all read)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="445" width="470" height="130" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;verification&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;verification-view · verification-banner&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="595" width="470" height="130" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;shortlist&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;shortlist-button · shortlist-view&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="595" width="470" height="130" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;admin&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;admin-overview · admin-verifications · document-preview · admin-users · admin-listings&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="745" width="470" height="130" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;auth / profile&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;login-form · register-form · auth-card · schemas.ts · profile-form&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="745" width="470" height="130" as="geometry"/></mxCell><mxCell id="c20" value="src/lib: infrastructure" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1680" y="100" width="680" height="820" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;lib/api&lt;/b&gt;&lt;br&gt;client.ts: fetch wrapper, credentials include, Bearer header&lt;br&gt;single-flight.ts: one refresh for concurrent 401s&lt;br&gt;errors.ts: ApiError(code, fieldErrors) from ProblemDetail&lt;br&gt;types.ts: all DTOs/enums from docs/API.md&lt;br&gt;auth · properties · search · visits · chat · notifications · verification · admin · shortlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="145" width="640" height="170" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;lib/auth&lt;/b&gt;&lt;br&gt;session-store.ts: access token in memory&lt;br&gt;auth-provider.tsx: boot-time silent refresh&lt;br&gt;use-auth.ts · require-auth.tsx (role guard, ?next=)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="330" width="640" height="110" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;lib/ws&lt;/b&gt;&lt;br&gt;ws-provider.tsx: STOMP client singleton, reconnect with backoff, reconnect on token refresh&lt;br&gt;realtime-handlers.ts: messages → chat cache · typing · read receipts · notifications → toasts + invalidations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="455" width="640" height="110" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;lib/query-client.ts&lt;/b&gt;: TanStack Query defaults (retry, staleTime)&lt;br&gt;&lt;b&gt;lib/format.ts&lt;/b&gt;: formatINR (₹25,000 / ₹1.2L), BHK labels&lt;br&gt;&lt;b&gt;lib/labels.ts&lt;/b&gt; · &lt;b&gt;forms.ts&lt;/b&gt; (server errors → RHF) · &lt;b&gt;protected-files.ts&lt;/b&gt; (blob URLs for private docs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="580" width="640" height="110" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;components/&lt;/b&gt;: ui kit (button, input, select, dialog, tabs, slider, chip, skeleton, empty/error states, pagination…) · layout (site-header, user-menu, dashboard-shell, admin-shell, sidebar-layout) · map (location-map, location-picker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="705" width="640" height="110" as="geometry"/></mxCell><mxCell id="c26" value="401 → refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="token changed → reconnect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Data flow&lt;/b&gt;: route → feature component → feature hook (useQuery/useMutation with key factory) → lib/api module → client.ts → /api/* (same origin) · realtime pushes enter through lib/ws and update the same Query cache, so UI updates without refetch logic in components." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="2320" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="10. Search Query Design"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;PropertySearchRepository: how a search becomes one parameterised SQL query&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2120" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Input&lt;/b&gt;: SearchFilters&lt;br&gt;city, locality, lat, lng, radiusKm,&lt;br&gt;minRent, maxRent, bhk[], propertyType[],&lt;br&gt;furnishing[], tenantPreference, amenities[],&lt;br&gt;availableBefore, keywords, sort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="170" as="geometry"/></mxCell><mxCell id="c4" value="&lt;pre style='font-size:11px;text-align:left;margin:0'&gt;SELECT p.*, cover.url,&#10;       ST_Distance(p.location, :point) / 1000 AS distance_km      -- only when geo&#10;FROM properties p JOIN users o ON o.id = p.owner_id&#10;WHERE p.status = 'ACTIVE' AND p.deleted_at IS NULL               -- PropertyVisibility&#10;  AND o.verification_status = 'VERIFIED' AND o.suspended = false&#10;  AND ST_DWithin(p.location, ST_MakePoint(:lng,:lat)::geography, :radiusM)   -- GiST&#10;  AND lower(p.city) = lower(:city)                               -- ix_properties_city&#10;  AND p.locality ILIKE :locality                                  -- trigram GIN&#10;  AND p.rent BETWEEN :minRent AND :maxRent&#10;  AND p.bhk = ANY(:bhk) AND p.property_type = ANY(:types) AND p.furnishing = ANY(:furn)&#10;  AND p.tenant_preference IN (:pref, 'ANY')&#10;  AND p.amenities @&amp;gt; :amenities                                   -- GIN, ALL must match&#10;  AND p.available_from &amp;lt;= :availableBefore&#10;  AND (p.title ILIKE :q OR p.description ILIKE :q OR p.locality ILIKE :q)&#10;ORDER BY &amp;lt;whitelisted&amp;gt;  -- DISTANCE | RENT_ASC | RENT_DESC | NEWEST&#10;LIMIT :size OFFSET :page*size;   + SELECT count(*) with the same WHERE&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="1100" height="420" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• Each predicate added only if the filter is present&lt;br&gt;• All values bound as parameters (no string concat)&lt;br&gt;• Sort column chosen from an enum whitelist&lt;br&gt;• RELEVANCE → DISTANCE when geo, else NEWEST&lt;br&gt;• size ≤ 100 · radius 0.5–50 km (default 5)&lt;br&gt;• Map endpoint: same WHERE, lightweight columns, LIMIT 500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1600" y="110" width="560" height="260" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;PageResponse&amp;lt;PropertySummaryDto&amp;gt;&lt;br&gt;{content, page, size, totalElements, totalPages}&lt;br&gt;+ shortlisted flag via ShortlistLookup (tenant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="360" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
