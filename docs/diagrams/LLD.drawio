 (limits, random keys)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2148" y="136" width="384" height="116" as="geometry"/></mxCell><mxCell id="c27" value="common" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2140" y="330" width="400" height="226" as="geometry"/></mxCell><mxCell id="c28" value="«filter» RequestIdFilter (MDC requestId)&lt;br&gt;«filter» RateLimitFilter + TokenBucket&lt;br&gt;«util» ClientIpResolver (TRUST_PROXY)&lt;br&gt;«error» ApiException · ErrorCode · FieldValidationException&lt;br&gt;«error» GlobalExceptionHandler → ProblemDetail&lt;br&gt;«util» ProblemResponseWriter · Problems&lt;br&gt;«model» PageResponse · Paging · CountResponse&lt;br&gt;«entity» BaseEntity (UUID id, audited timestamps)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2148" y="366" width="384" height="182" as="geometry"/></mxCell><mxCell id="c29" value="config" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2140" y="600" width="400" height="182" as="geometry"/></mxCell><mxCell id="c30" value="SecurityConfig (stateless, JWT resource server)&lt;br&gt;WebSocketConfig (STOMP /ws, broker, interceptor)&lt;br&gt;WebConfig (/ → Swagger UI redirect)&lt;br&gt;OpenApiConfig (bearer scheme)&lt;br&gt;PersistenceConfig (JPA auditing)&lt;br&gt;AppProperties (typed app.* config)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;alig