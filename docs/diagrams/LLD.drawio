elBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="c3" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="sender" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="c3" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Extensions&lt;/b&gt;: postgis (geography, ST_DWithin, ST_Distance) · pg_trgm (fuzzy ILIKE on title/locality)&lt;br&gt;&lt;b&gt;Integrity&lt;/b&gt;: CHECK constraints on enums, bhk range, rent &gt; 0, lat/lng ranges · partial unique index allows only one open visit per tenant+property" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="820" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3. Request Pipeline &amp; Security"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;Request pipeline: HTTP and STOMP paths through the backend&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;Every request passes the same filters; errors become RFC 9457 problem+json responses&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2320" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;fetch('/api/v1/...')&lt;br&gt;Authorization: Bearer &amp;lt;access JWT&amp;gt;&lt;br&gt;Cookie: er_refresh (auth paths only)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="350" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Caddy :443&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;TLS termination&lt;br&gt;route → frontend:3000&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="425" y="110" width="350" height="120" as="geometry"/></mxCell><mxCell id="c5" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Next.js rewrite&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;/api/:path* →&lt;br&gt;http://backend:8080&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="110" width="350" height="120" as="geometry"/></mxCell><mxCell id="c7" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;RequestIdFilter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;X-Request-Id or new UUID&lt;br&gt;→ MDC requestId → response header&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1195" y="110" width="350" height="120" as="geometry"/></mxCell><mxCell id="c9" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;RateLimitFilter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Token bucket per client IP&lt;br&gt;login/register 10/min · /search/ai 20/min&lt;br&gt;→ 429 RATE_LIMITED&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1580" y="110" width="350" height="120" as="geometry"/></mxCell><mxCell id="c11" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;CorsFilter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;CORS_ALLOWED_ORIGINS&lt;br&gt;credentials allowed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1965" y="110" width="350" height="120" as="geometry"/></mxCell><mxCell id="c13" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;BearerToken AuthFilter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;JwtService verifies HS256, iss, exp&lt;br&gt;JwtPrincipalConverter →&lt;br&gt;AuthenticatedUser(id, role)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="350" height="120" as="geometry"/></mxCell><mxCell id="c15" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;AuthorizationFilter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;permitAll: auth, search, GET property/{id}, files, ws, docs, health&lt;br&gt;role gates per path&lt;br&gt;else authenticated&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="425" y="400" width="350" height="120" as="geometry"/></mxCell><mxCell id="c17" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;DispatcherServlet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;@PreAuthorize(hasRole…)&lt;br&gt;@Valid request DTO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="400" width="350" height="120" as="geometry"/></mxCell><mxCell id=