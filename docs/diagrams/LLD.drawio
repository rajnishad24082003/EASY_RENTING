<mxfile host="app.diagrams.net" type="device"><diagram id="p0" name="1. Backend Modules &amp; Classes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;Backend: package-by-feature modules (com.easyrenting)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;Each package owns its controller → service → repository → entity slice. Arrows = compile-time dependencies between modules.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2520" height="60" as="geometry"/></mxCell><mxCell id="c3" value="auth" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="380" height="270" as="geometry"/></mxCell><mxCell id="c4" value="«controller» AuthController  /api/v1/auth&lt;br&gt;«service» AuthService: register, login, refresh, logout&lt;br&gt;«service» RefreshTokenService: issue, rotate, revoke, revokeAll&lt;br&gt;«service» JwtService: HS256 sign/verify (15 min)&lt;br&gt;«entity» RefreshToken (family_id, token_hash, revoked_at)&lt;br&gt;«repo» RefreshTokenRepository&lt;br&gt;«security» JwtPrincipalConverter → AuthenticatedUser&lt;br&gt;«security» StompAuthChannelInterceptor (CONNECT)&lt;br&gt;«security» ProblemSecurityHandlers (401/403 JSON)&lt;br&gt;«util» RefreshCookies (er_refresh) · AuthDtos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="136" width="364" height="226" as="geometry"/></mxCell><mxCell id="c5" value="user" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="380" height="204" as="geometry"/></mxCell><mxCell id="c6" value="«controller» UserController  /api/v1/users/me&lt;br&gt;«service» UserService: profile, lookups&lt;br&gt;«entity» User (role, verificationStatus, suspended)&lt;br&gt;«repo» UserRepository&lt;br&gt;«enum» Role {TENANT, OWNER, ADMIN}&lt;br&gt;«enum» VerificationStatus&lt;br&gt;«dto» UserDto · UpdateProfileRequest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="466" width="364" height="160" as="geometry"/></mxCell><mxCell id="c7" value="property" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="380" height="270" as="geometry"/></mxCell><mxCell id="c8" value="«controller» PropertyController  /api/v1/properties&lt;br&gt;«service» PropertyService: CRUD, status, ownership&lt;br&gt;«service» PropertyImageService: upload, cover, delete&lt;br&gt;«entity» Property (@Version) · PropertyImage&lt;br&gt;«repo» PropertyRepository&lt;br&gt;«rule» PropertyVisibility (single public predicate)&lt;br&gt;«mapper» PropertyMapper · PropertyDtos&lt;br&gt;«enum» PropertyType · Furnishing · TenantPreference&lt;br&gt;«enum» PropertyStatus · Amenity&lt;br&gt;«dto» PropertyRequest (validated)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="468" y="136" width="364" height="226" as="geometry"/></mxCell><mxCell 