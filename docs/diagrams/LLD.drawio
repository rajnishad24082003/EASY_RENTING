ne;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="images" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c7" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c15" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c17" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="NEW_MESSAGE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="private docs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c21" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c23" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c23" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;curved=1;edgeStyle=none;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Layering inside every module&lt;/b&gt;&lt;br&gt;Controller (thin, @Valid DTO records, @PreAuthorize) → Service (@Transactional, business rules, ownership checks, publishes events) → Repository (Spring Data JPA / JdbcClient) → Entity (JPA, BaseEntity).&lt;br&gt;&lt;b&gt;common&lt;/b&gt; and &lt;b&gt;config&lt;/b&gt; are used by every module (arrows omitted)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1240" height="90" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="200" height="20" as="geometry"/></mxCell><mxCell id="c49" value="Auth / security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1045" width="200" height="26" as="geometry"/></mxCell><mxCell id="c50" value="Domain module" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1077" width="200" height="26" as="geometry"/></mxCell><mxCell id="c51" value="Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1109" width="200" height="26" as="geometry"/></mxCell><mxCell id="c52" value="Cross-cutting / config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1141" width="200" height="26" as="geometry"/></mxCell><mxCell id="c53" value="Demo-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1173" width="200" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Database ER Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;Database schema: PostgreSQL 17 + PostGIS (Flyway V1__init.sql)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;PK = primary key · FK = foreign key · UQ = unique · all ids are UUID · created_at/updated_at on every table (JPA auditing)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2520" height="60" as="geometry"/></mxCell><mxCell id="c3" value="users" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="460" height="309" as="geometry"/></mxCell><mxCell id="c4" value="&lt;table style='width:100%;font-size:11px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;PK&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;name&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;varchar(80)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;UQ&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;email&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;varchar(254) · lower()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;phone&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;varchar(10)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;password_hash&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;varchar(100) bcrypt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;role&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;TENANT|OWNER|ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;verification_status&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;UNVERIFIED|PENDING|VERIFIED|REJECTED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;verification_submitted_at&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;verification_reviewed_at&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;verification_rejection_reason&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;varchar(500)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;avatar_url&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;varchar(512)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;suspended&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;boolean&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px'&gt;&lt;b&gt;created_at / updated_at&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;color:#555'&gt;timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;hr style='margin:4px 0'&gt;&lt;div style='font-size:10px;color:#444;text-align:left'&gt;ux_users_email (LOWER(email)) UNIQUE&lt;br&gt;ix_users_role · ix_users_verification_status&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeColor=none;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="904" y="132" width="452" height="273" as="geometry"/></mxCell><mxCell id="c5" value="refresh_tokens" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;