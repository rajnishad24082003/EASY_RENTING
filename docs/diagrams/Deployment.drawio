<mxfile host="app.diagrams.net" type="device"><diagram id="p0" name="1. Production Topology (Oracle Cloud)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;Production deployment: Oracle Cloud Always Free (ap-mumbai-1)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;Single VM · Docker Compose · Caddy automatic HTTPS · $0/month&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2320" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Visitors /&lt;br&gt;recruiters" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="40" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;sslip.io DNS&lt;/b&gt;&lt;br&gt;140-238-162-30.sslip.io&lt;br&gt;→ 140.238.162.30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="230" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Let's Encrypt&lt;/b&gt;&lt;br&gt;(ZeroSSL fallback)&lt;br&gt;HTTP-01 / TLS-ALPN-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="230" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Browser-side 3rd parties&lt;/b&gt;&lt;br&gt;OpenStreetMap tiles&lt;br&gt;Unsplash images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="230" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Oracle Cloud · Region India West (Mumbai) ap-mumbai-1 · Tenancy rajnishad24082003 (Free Tier, never upgraded)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="2030" height="1300" as="geometry"/></mxCell><mxCell id="c8" value="VCN vcn-20261009-0007 (10.0.0.0/16)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="1970" height="1220" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Internet Gateway&lt;/b&gt;&lt;br&gt;Default Route Table:&lt;br&gt;0.0.0.0/0 → IGW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Default Security List&lt;/b&gt; (stateful)&lt;br&gt;Ingress: TCP 22 · TCP 80 · TCP 443 from 0.0.0.0/0&lt;br&gt;ICMP 3,4 from 0.0.0.0/0&lt;br&gt;Egress: all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="320" width="230" height="140" as="geometry"/></mxCell><mxCell id="c11" value="Public subnet subnet-20261009-0007 (10.0.0.0/24) · AD-1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=13;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="660" y="200" width="1640" height="1140" as="geometry"/></mxCell><mxCell id="c12" value="Compute instance 'easyrenting' · VM.Standard.E2.1.Micro (Always Free) · 1 OCPU (AMD) · 1 GB RAM · 0.48 Gbps · Ubuntu 24.04 · boot volume ~47 GB · private 10.0.0.158 · ephemeral public 140.238.162.30" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="690" y="250" width="1580" height="1060" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Host OS&lt;/b&gt;&lt;br&gt;iptables (netfilter-persistent): ACCEPT 22, 80, 443 then REJECT&lt;br&gt;3 GB /swapfile · Docker Engine + Compose v2 · user ubuntu (docker group)&lt;br&gt;SSH key auth only (easyrenting.key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="300" width="700" height="95" as="geometry"/></mxCell><mxCell id="c14" value="Docker Compose project 'easyrenting' (~/easyrenting) · network easyrenting_default (bridge) · restart: always" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="710" y="410" width="1540" height="880" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;caddy&lt;/b&gt; · image caddy:2-alpine&lt;br&gt;Published 0.0.0.0:80, :443&lt;br&gt;Caddyfile (read-only mount)&lt;br&gt;Auto TLS for {$SITE_HOST}&lt;br&gt;/ws*, /swagger-ui*, /v3/api-docs* → backend:8080&lt;br&gt;else → frontend:3000&lt;br&gt;volumes: caddy_data (certs), caddy_config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="460" width="420" height="190" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;frontend&lt;/b&gt; · easyrenting-frontend:latest&lt;br&gt;Next.js 16 standalone · node:24-alpine · uid 1001&lt;br&gt;:3000 (internal only)&lt;br&gt;BACKEND_URL=http://backend:8080 (build arg)&lt;br&gt;NEXT_PUBLIC_WS_URL=wss://…/ws (build arg)&lt;br&gt;NODE_OPTIONS=--max-old-space-size=160&lt;br&gt;healthcheck: HTTP GET /" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1220" y="460" width="460" height="190" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;backend&lt;/b&gt; · easyrenting-backend:latest&lt;br&gt;Spring Boot 4.1 · eclipse-temurin:25-jre · non-root 'app'&lt;br&gt;:8080 (internal only)&lt;br&gt;SPRING_PROFILES_ACTIVE=prod,demo · TRUST_PROXY=true&lt;br&gt;JAVA_TOOL_OPTIONS=-Xmx256m -XX:+UseSerialGC&lt;br&gt;  -XX:MaxMetaspaceSize=200m -XX:TieredStopAtLevel=1&lt;br&gt;Hikari pool 5 · healthcheck /actuator/health&lt;br&gt;volume: uploads → /app/data/uploads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1220" y="700" width="460" height="220" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;postgres&lt;/b&gt; · postgis/postgis:17-3.5&lt;br&gt;:5432 (internal only)&lt;br&gt;shared_buffers=32MB · max_connections=20&lt;br&gt;work_mem=2MB · effective_cache_size=128MB&lt;br&gt;healthcheck: pg_isready&lt;br&gt;volume: pgdata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1740" y="700" width="470" height="170" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Named volumes&lt;/b&gt; (persist across deploys)&lt;br&gt;easyrenting_pgdata · easyrenting_uploads&lt;br&gt;easyrenting_caddy_data · easyrenting_caddy_config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1740" y="460" width="470" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;~/easyrenting/.env&lt;/b&gt; (copied from deploy/.env.production)&lt;br&gt;SITE_HOST · PUBLIC_APP_URL · PUBLIC_WS_URL · COOKIE_SECURE=true&lt;br&gt;JWT_SECRET · POSTGRES_PASSWORD · SPRING_PROFILES_ACTIVE · ANTHROPIC_API_KEY (empty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="700" width="420" height="130" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Memory budget (1 GB + 3 GB swap)&lt;/b&gt;&lt;br&gt;backend ~350–450 MB · postgres ~60–100 MB&lt;br&gt;frontend ~100–160 MB · caddy ~20 MB&lt;br&gt;Cold start ≈ 70 s (JIT C1 only, serial GC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="860" width="420" height="110" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Ports exposed to the internet&lt;/b&gt;: 80 (ACME + redirect) and 443 (HTTPS + WSS) only.&lt;br&gt;Postgres, backend and frontend have no published ports and are reachable only on the Compose network." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1220" y="960" width="990" height="60" as="geometry"/></mxCell><mxCell id="c23" value="1. resolve name" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="2. HTTPS 443 / WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="3. allowed 80/443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="HTTP :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="WS /ws · docs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="/api/* rewrite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="JDBC :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="ACME challenge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="tiles / images" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Build &amp; Release Pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;Build &amp; release: CI on GitHub, release from the developer laptop&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;The 1 GB server can't build Java/Next.js, so images are built locally and streamed over SSH&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2320" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Developer laptop (x86_64, Docker 20.10 + Compose v2)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1150" height="980" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Source&lt;/b&gt; git repo: backend/ · frontend/ · deploy/ · docs/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="145" width="1110" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Secrets kept locally (git-ignored)&lt;/b&gt;&lt;br&gt;easyrenting.key (SSH, chmod 600)&lt;br&gt;deploy/.env.production (JWT_SECRET, POSTGRES_PASSWORD, SITE_HOST…)&lt;br&gt;Backed up to private Google Drive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="540" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Local dev&lt;/b&gt;&lt;br&gt;er-pg-dev PostGIS on :5433&lt;br&gt;./mvnw spring-boot:run (profile demo) :8080&lt;br&gt;npm run dev :3000 (rewrites /api → :8080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="630" y="210" width="540" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;1. Build&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;docker compose --env-file deploy/.env.production&lt;br&gt;-f docker-compose.yml -f deploy/docker-compose.prod.yml&lt;br&gt;build backend frontend&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="530" height="140" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2. Backend image&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Stage build: eclipse-temurin:25-jdk · ./mvnw -B -DskipTests package&lt;br&gt;→ layertools extract&lt;br&gt;Stage run: eclipse-temurin:25-jre, non-root&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="350" width="530" height="140" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;3. Frontend image&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;deps → build (NEXT_PUBLIC_WS_URL baked in) → runner&lt;br&gt;node:24-alpine · output: standalone · uid 1001&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="530" height="140" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;4. Copy config&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;scp docker-compose.yml → ~/easyrenting/&lt;br&gt;scp deploy/{docker-compose.prod.yml, Caddyfile, reset-demo.sh}&lt;br&gt;scp deploy/.env.production → ~/easyrenting/.env&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="520" width="530" height="140" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;5. Ship images&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;docker save easyrenting-backend easyrenting-frontend&lt;br&gt;| gzip | ssh ubuntu@140.238.162.30 'gunzip | docker load'&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="530" height="140" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;6. Start&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;ssh … docker compose up -d --no-build --remove-orphans&lt;br&gt;docker image prune -f&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="690" width="530" height="140" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;deploy/deploy.sh ubuntu@IP easyrenting.key&lt;/b&gt; runs steps 1–6 in one command (idempotent; re-run for every release)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="1110" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;One-time&lt;/b&gt;: ssh … 'bash -s' &amp;lt; deploy/server-setup.sh → iptables 80/443, 3 GB swap, Docker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="935" width="1110" height="45" as="geometry"/></mxCell><mxCell id="c20" value="Oracle VM (ubuntu@140.238.162.30)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1260" y="520" width="1100" height="400" as="geometry"/></mxCell><mxCell id="c21" value="docker load → images easyrenting-backend:latest, easyrenting-frontend:latest&lt;br&gt;docker pull → postgis/postgis:17-3.5, caddy:2-alpine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1280" y="570" width="1060" height="70" as="geometry"/></mxCell><mxCell id="c22" value="Flyway migrates the schema on backend start (V1__init.sql)&lt;br&gt;DemoDataSeeder seeds once (idempotent) under profile demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1280" y="655" width="1060" height="70" as="geometry"/></mxCell><mxCell id="c23" value="Caddy obtains/renews the TLS certificate automatically&lt;br&gt;Data volumes survive every redeploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1280" y="740" width="1060" height="70" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;reset-demo.sh&lt;/b&gt;: stop backend+postgres → remove pgdata &amp; uploads volumes → up → fresh seed (certs kept)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1280" y="825" width="1060" height="60" as="geometry"/></mxCell><mxCell id="c25" value="SSH (port 22)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="GitHub Actions CI (.github/workflows/ci.yml) · on push to main &amp; PRs" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1260" y="100" width="1100" height="380" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;backend&lt;/b&gt;&lt;br&gt;setup-java 25 (temurin, maven cache)&lt;br&gt;./mvnw -B verify&lt;br&gt;unit + Testcontainers PostGIS + STOMP tests&lt;br&gt;upload surefire reports on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1280" y="145" width="340" height="180" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;setup-node 24 (npm cache)&lt;br&gt;npm ci · lint · tsc --noEmit&lt;br&gt;vitest · next build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="145" width="340" height="180" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;docker&lt;/b&gt; (needs both)&lt;br&gt;buildx build backend &amp; frontend&lt;br&gt;push: false · GHA layer cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="2000" y="145" width="340" height="180" as="geometry"/></mxCell><mxCell id="c30" value="CI validates every change; releases are manual from the laptop (no registry or cloud credentials stored in GitHub)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1280" y="345" width="1060" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3. Network &amp; Security Layers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;Defence in depth: every layer a request passes on the way in&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2120" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:14px'&gt;1. Oracle Security List&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stateful cloud firewall on the subnet&lt;br&gt;Ingress only 22, 80, 443 (+ ICMP path-MTU)&lt;br&gt;Everything else dropped before reaching the VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="500" height="240" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:14px'&gt;2. Host iptables&lt;/b&gt;&lt;br&gt;&lt;br&gt;INPUT: ACCEPT 80, 443, 22, established&lt;br&gt;final REJECT icmp-host-prohibited&lt;br&gt;Persisted with netfilter-persistent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="110" width="500" height="240" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:14px'&gt;3. Docker network isolation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Only caddy publishes ports&lt;br&gt;postgres/backend/frontend reachable only on easyrenting_default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="500" height="240" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:14px'&gt;4. TLS (Caddy)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Let's Encrypt certificate, auto-renewed&lt;br&gt;HTTP → HTTPS redirect · HTTP/2&lt;br&gt;Replaces spoofed X-Forwarded-For" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1630" y="110" width="500" height="240" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:14px'&gt;5. App filters&lt;/b&gt;&lt;br&gt;&lt;br&gt;Request IDs · per-IP rate limits (TRUST_PROXY=true)&lt;br&gt;CORS = https://140-238-162-30.sslip.io&lt;br&gt;WS allowed origins = same" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="500" height="240" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:14px'&gt;6. AuthN / AuthZ&lt;/b&gt;&lt;br&gt;&lt;br&gt;JWT HS256 (15 min) · refresh cookie httpOnly + Secure + SameSite=Lax, Path=/api/v1/auth&lt;br&gt;Role gates + @PreAuthorize + service ownership checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="410" width="500" height="240" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:14px'&gt;7. Data protection&lt;/b&gt;&lt;br&gt;&lt;br&gt;BCrypt(12) passwords · SHA-256 refresh token hashes&lt;br&gt;KYC docs under private/ (owner + admin only)&lt;br&gt;Upload magic-byte sniffing, size limits, no path traversal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="410" width="500" height="240" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style='font-size:14px'&gt;8. Secrets&lt;/b&gt;&lt;br&gt;&lt;br&gt;JWT_SECRET &amp; POSTGRES_PASSWORD random hex, only in .env (git-ignored, chmod 600)&lt;br&gt;No Anthropic key in prod (avoids billable abuse)&lt;br&gt;SSH key auth only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1630" y="410" width="500" height="240" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Known limits (acceptable for a demo)&lt;/b&gt;: demo accounts share a public password (reset with reset-demo.sh) · single VM = single point of failure · ephemeral IP changes only if the instance is terminated · Oracle may stop idle Always Free instances (restart from console)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="2100" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4. Environments"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;Environments and how they differ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2120" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Local dev (laptop)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="500" height="560" as="geometry"/></mxCell><mxCell id="c4" value="PostGIS container er-pg-dev → host :5433" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="145" width="470" height="65" as="geometry"/></mxCell><mxCell id="c5" value="Backend: ./mvnw spring-boot:run · profiles default+demo · dev JWT secret default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="225" width="470" height="65" as="geometry"/></mxCell><mxCell id="c6" value="Frontend: npm run dev :3000 · rewrites /api → localhost:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="305" width="470" height="65" as="geometry"/></mxCell><mxCell id="c7" value="WS: ws://localhost:8080/ws" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="385" width="470" height="65" as="geometry"/></mxCell><mxCell id="c8" value="Cookie Secure=false (plain HTTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="465" width="470" height="65" as="geometry"/></mxCell><mxCell id="c9" value="Optional ANTHROPIC_API_KEY to try Claude parsing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="545" width="470" height="65" as="geometry"/></mxCell><mxCell id="c10" value="Local full stack (docker compose up)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="570" y="100" width="500" height="560" as="geometry"/></mxCell><mxCell id="c11" value="docker-compose.yml only (no prod override)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="145" width="470" height="65" as="geometry"/></mxCell><mxCell id="c12" value="Ports: 3000 (web), 8080 (API + Swagger), 5433 (DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="225" width="470" height="65" as="geometry"/></mxCell><mxCell id="c13" value="Profiles prod,demo · secrets from root .env" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="305" width="470" height="65" as="geometry"/></mxCell><mxCell id="c14" value="postgis/postgis:17-3.5 (amd64)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="385" width="470" height="65" as="geometry"/></mxCell><mxCell id="c15" value="Builds images locally from Dockerfiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="465" width="470" height="65" as="geometry"/></mxCell><mxCell id="c16" value="Tests / CI" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="500" height="560" as="geometry"/></mxCell><mxCell id="c17" value="Testcontainers postgis/postgis:17-3.5 per test run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="145" width="470" height="65" as="geometry"/></mxCell><mxCell id="c18" value="Profile test · temp upload dir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="225" width="470" height="65" as="geometry"/></mxCell><mxCell id="c19" value="Vitest (jsdom) for frontend units" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="305" width="470" height="65" as="geometry"/></mxCell><mxCell id="c20" value="Playwright e2e against a running seeded stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="385" width="470" height="65" as="geometry"/></mxCell><mxCell id="c21" value="GitHub Actions: backend verify, frontend checks, docker build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="465" width="470" height="65" as="geometry"/></mxCell><mxCell id="c22" value="Production (Oracle)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1630" y="100" width="500" height="560" as="geometry"/></mxCell><mxCell id="c23" value="docker-compose.yml + deploy/docker-compose.prod.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="145" width="470" height="65" as="geometry"/></mxCell><mxCell id="c24" value="Only Caddy published (80/443) · automatic HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="225" width="470" height="65" as="geometry"/></mxCell><mxCell id="c25" value="Memory-tuned for 1 GB (JVM 256 MB heap, PG 32 MB buffers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="305" width="470" height="65" as="geometry"/></mxCell><mxCell id="c26" value="Profiles prod,demo · ECS JSON logs · COOKIE_SECURE=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="385" width="470" height="65" as="geometry"/></mxCell><mxCell id="c27" value="Images built on laptop, shipped via SSH (deploy.sh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="465" width="470" height="65" as="geometry"/></mxCell><mxCell id="c28" value="https://140-238-162-30.sslip.io" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="545" width="470" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
