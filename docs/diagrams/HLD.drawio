<mxfile host="app.diagrams.net" type="device"><diagram id="p0" name="1. System Context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;EasyRenting: System Context (C4 Level 1)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;Who uses the platform and which external systems it depends on&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1920" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Tenant" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="40" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Owner" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="450" width="40" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="700" width="40" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Visitor&lt;br&gt;(not logged in)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="940" width="40" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:18px'&gt;EasyRenting Platform&lt;/b&gt;&lt;br&gt;&lt;br&gt;Zero-brokerage rental marketplace&lt;br&gt;• Geo + filter property search (PostGIS)&lt;br&gt;• AI natural-language search&lt;br&gt;• Real-time owner ↔ tenant chat (WebSocket)&lt;br&gt;• Visit scheduling with live notifications&lt;br&gt;• Owner KYC verification + admin moderation&lt;br&gt;&lt;br&gt;&lt;i&gt;Next.js 16 · Spring Boot 4 · PostgreSQL 17&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="380" width="460" height="330" as="geometry"/></mxCell><mxCell id="c8" value="Search &amp; AI search, shortlist,&lt;br&gt;chat with owners, request visits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="List properties, upload photos,&lt;br&gt;submit KYC docs, answer visits &amp; chats" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="Approve/reject owners, suspend users,&lt;br&gt;moderate listings, view stats" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="Browse &amp; search listings,&lt;br&gt;view details (read-only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Claude API&lt;/b&gt; (Anthropic)&lt;br&gt;&lt;i&gt;claude-opus-5-5&lt;/i&gt;&lt;br&gt;Structured outputs → SearchFilters&lt;br&gt;&lt;span style='color:#b85450'&gt;Optional: disabled in prod (no API key)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="160" width="330" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;OpenStreetMap tile servers&lt;/b&gt;&lt;br&gt;Map tiles for Leaflet (browser fetches directly)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="320" width="330" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Unsplash Images CDN&lt;/b&gt;&lt;br&gt;Seeded demo listing photos (browser fetches directly)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="440" width="330" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;sslip.io wildcard DNS&lt;/b&gt;&lt;br&gt;140-238-162-30.sslip.io → 140.238.162.30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="560" width="330" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Let's Encrypt / ZeroSSL (ACME)&lt;/b&gt;&lt;br&gt;Free TLS certificates, auto-renewed by Caddy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="680" width="330" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Oracle Cloud Infrastructure&lt;/b&gt;&lt;br&gt;Always Free VM.Standard.E2.1.Micro&lt;br&gt;ap-mumbai-1 (hosting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="800" width="330" height="90" as="geometry"/></mxCell><mxCell id="c18" value="HTTPS · parse query → JSON filters&lt;br&gt;(15 s timeout, cached 1 h, falls back to rules)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="HTTPS tiles (from browser)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="HTTPS images (from browser)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="DNS lookup (from browser)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="ACME HTTP-01 challenge (Caddy)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="Runs on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#9673a6;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Scope:&lt;/b&gt; one deployable system (3 app containers + DB). All user traffic is HTTPS on 443; real-time traffic is WebSocket (wss://…/ws)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="760" width="460" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Container Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;EasyRenting: Container Architecture (C4 Level 2)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;Runtime building blocks, responsibilities and the protocols between them&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2320" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Client tier: Browser (React 19 SPA, rendered by Next.js)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="1000" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Pages &amp; UI kit&lt;/b&gt;&lt;br&gt;App Router routes, Tailwind v4,&lt;br&gt;Radix primitives, lucide icons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="480" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;TanStack Query v5&lt;/b&gt;&lt;br&gt;Server-state cache, query-key factories,&lt;br&gt;optimistic updates, invalidation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="480" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Auth session store&lt;/b&gt;&lt;br&gt;Access JWT in memory only (15 min)&lt;br&gt;Single-flight refresh on 401 → retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="480" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;API client&lt;/b&gt; (fetch wrapper)&lt;br&gt;credentials: include · ProblemDetail → ApiError&lt;br&gt;Field errors → react-hook-form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="480" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;STOMP client&lt;/b&gt; (@stomp/stompjs)&lt;br&gt;Bearer token on CONNECT, backoff reconnect,&lt;br&gt;subscribes /user/queue/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="480" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Realtime handlers&lt;/b&gt;&lt;br&gt;Push → Query cache (append message, unread counts,&lt;br&gt;invalidate visits/verification), toasts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="480" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Leaflet map&lt;/b&gt; (react-leaflet, client-only)&lt;br&gt;Pins, radius circle, 'search this area'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="480" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Forms&lt;/b&gt;: react-hook-form + zod schemas&lt;br&gt;mirroring backend validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="480" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;URL state&lt;/b&gt;: search filters serialised to query string&lt;br&gt;(shareable, survives reload)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="480" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;httpOnly cookie&lt;/b&gt; er_refresh&lt;br&gt;Path=/api/v1/auth · SameSite=Lax · Secure · 30 d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="480" height="60" as="geometry"/></mxCell><mxCell id="c14" value="Edge: Caddy 2 reverse proxy" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="360" height="330" as="geometry"/></mxCell><mxCell id="c15" value="TLS termination (auto HTTPS via ACME)&lt;br&gt;HTTP → HTTPS redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="145" width="320" height="55" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Routing&lt;/b&gt;&lt;br&gt;/ws, /ws/* → backend:8080 (WebSocket upgrade)&lt;br&gt;/swagger-ui*, /v3/api-docs* → backend:8080&lt;br&gt;everything else → frontend:3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="210" width="320" height="95" as="geometry"/></mxCell><mxCell id="c17" value="zstd/gzip compression&lt;br&gt;Sets X-Forwarded-For/-Proto (drops spoofed XFF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="315" width="320" height="55" as="geometry"/></mxCell><mxCell id="c18" value="Only container with published ports: 80, 443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="380" width="320" height="35" as="geometry"/></mxCell><mxCell id="c19" value="Web tier: Next.js 16 server (standalone, Node 24)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="480" width="360" height="300" as="geometry"/></mxCell><mxCell id="c20" value="Server-renders pages (RSC)&lt;br&gt;generateMetadata: listing title via backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="525" width="320" height="55" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;rewrites()&lt;/b&gt;: /api/:path* → http://backend:8080/api/:path*&lt;br&gt;→ refresh cookie stays first-party" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="590" width="320" height="60" as="geometry"/></mxCell><mxCell id="c22" value="Static assets, image optimisation,&lt;br&gt;route groups (marketing) / (app)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="660" width="320" height="55" as="geometry"/></mxCell><mxCell id="c23" value="NODE_OPTIONS=--max-old-space-size=160" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="725" width="320" height="35" as="geometry"/></mxCell><mxCell id="c24" value="Application tier: Spring Boot 4.1 (Java 25, embedded Tomcat :8080)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1080" y="100" width="860" height="1000" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Servlet filter chain&lt;/b&gt;&lt;br&gt;RequestIdFilter (MDC requestId, X-Request-Id) → RateLimitFilter (token bucket/IP)&lt;br&gt;→ CORS → BearerTokenAuthenticationFilter (HS256 JWT) → AuthorizationFilter (URL + role gates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="145" width="820" height="75" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;REST controllers&lt;/b&gt; /api/v1/*&lt;br&gt;Auth · Users · Properties · Search · AI Search · Shortlist&lt;br&gt;Visits · Conversations · Notifications · Verification · Admin · Files&lt;br&gt;@Valid DTOs · @PreAuthorize · ProblemDetail errors (RFC 9457)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="235" width="400" height="120" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;STOMP over WebSocket&lt;/b&gt; /ws&lt;br&gt;Simple broker /queue, /topic · app prefix /app&lt;br&gt;StompAuthChannelInterceptor (JWT on CONNECT)&lt;br&gt;@MessageMapping chat.send / chat.typing / chat.read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1520" y="235" width="400" height="120" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Domain services&lt;/b&gt; (@Transactional, ownership &amp; role rules)&lt;br&gt;AuthService · RefreshTokenService · UserService · PropertyService · PropertyImageService&lt;br&gt;SearchService · LocalityService · AiSearchService · ShortlistService · VisitService (+ VisitStateMachine, VisitSlotPolicy)&lt;br&gt;ChatService · NotificationService · VerificationService · AdminService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="375" width="820" height="105" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;AI query parsing&lt;/b&gt;&lt;br&gt;QueryParser ← ClaudeQueryParser (if key)&lt;br&gt;RuleBasedQueryParser (always)&lt;br&gt;AiExtractionSanitizer · ExplanationBuilder&lt;br&gt;LocalityGazetteer (64 localities)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="500" width="400" height="130" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Domain events&lt;/b&gt;&lt;br&gt;ApplicationEventPublisher →&lt;br&gt;@TransactionalEventListener(AFTER_COMMIT)&lt;br&gt;ChatEventsListener · NotificationPushListener&lt;br&gt;→ SimpMessagingTemplate.convertAndSendToUser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1520" y="500" width="400" height="130" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Persistence&lt;/b&gt;&lt;br&gt;Spring Data JPA repositories (Hibernate 7, ddl validate)&lt;br&gt;PropertySearchRepository: dynamic SQL via JdbcClient (ST_DWithin, ST_Distance)&lt;br&gt;HikariCP pool · Flyway migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="820" height="90" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;StorageService&lt;/b&gt; → LocalStorageService&lt;br&gt;Magic-byte content sniffing, size limits,&lt;br&gt;random keys, path-traversal guard&lt;br&gt;public/ (images) · private/ (KYC docs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="760" width="400" height="110" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;Actuator: /actuator/health, info, prometheus&lt;br&gt;springdoc: /v3/api-docs, /swagger-ui.html&lt;br&gt;Demo seeder (profile demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1520" y="760" width="400" height="110" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Cross-cutting&lt;/b&gt;: GlobalExceptionHandler (ProblemDetail), ProblemSecurityHandlers (401/403 JSON), AppProperties (typed config), JPA auditi