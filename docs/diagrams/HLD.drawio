;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="285" width="470" height="60" as="geometry"/></mxCell><mxCell id="c24" value="KYC verification: upload ID docs (private storage), submit for review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="355" width="470" height="60" as="geometry"/></mxCell><mxCell id="c25" value="Listings are hidden until owner is VERIFIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="425" width="470" height="60" as="geometry"/></mxCell><mxCell id="c26" value="Visit requests: confirm, decline, propose new time, mark complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="495" width="470" height="60" as="geometry"/></mxCell><mxCell id="c27" value="Chat with tenants in real time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="565" width="470" height="60" as="geometry"/></mxCell><mxCell id="c28" value="Admin" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1630" y="100" width="500" height="620" as="geometry"/></mxCell><mxCell id="c29" value="Overview stats: users, owners, tenants, verified owners, pending verifications, listings, visits &amp; messages this week" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="145" width="470" height="60" as="geometry"/></mxCell><mxCell id="c30" value="Verification queue: view private documents, approve, reject with reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="215" width="470" height="60" as="geometry"/></mxCell><mxCell id="c31" value="Users: search, filter by role, suspend / unsuspend (suspended users can't log in; their listings are hidden)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="285" width="470" height="60" as="geometry"/></mxCell><mxCell id="c32" value="Listings: search, filter by status, change status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="355" width="470" height="60" as="geometry"/></mxCell><mxCell id="c33" value="Can edit/delete any listing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1645" y="425" width="470" height="60" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style='font-size:16px'&gt;Non-functional characteristics&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="600" height="30" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;BCrypt(12) passwords · 15-min JWT in memory · rotated hashed refresh tokens with reuse detection · httpOnly SameSite cookie · role + ownership checks · rate limiting · magic-byte upload validation · private KYC files · RFC 9457 errors without stack traces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="680" height="120" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Real-time&lt;/b&gt;&lt;br&gt;STOMP over native WebSocket · per-user queues · events pushed only after DB commit · REST fallback when socket is down · auto-reconnect with fresh token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="780" width="680" height="120" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Data &amp; search&lt;/b&gt;&lt;br&gt;PostGIS geography + GiST for radius queries · GIN on amenities[] · trigram on title/locality · one shared visibility predicate · Flyway-versioned schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1440" y="780" width="680" height="120" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;Request-ID in every log line and response header · ECS structured logs (prod) · Actuator health + Prometheus metrics · OpenAPI docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="680" height="120" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Quality&lt;/b&gt;&lt;br&gt;88 backend tests (Testcontainers + PostGIS, STOMP) · 57 frontend unit tests (Vitest) · Playwright e2e incl. two-browser real-time flow · CI on GitHub Actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="920" width="680" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4. Key Design Decisions"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:24px'&gt;EasyRenting: Architecture Decisions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;Why the system is built the way it is&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2120" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:14px'&gt;ADR-1 Geo search in the database&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision: PostGIS geography column GENERATED from latitude/longitude, GiST index, ST_DWithin + ST_Distance.&lt;br&gt;Why: exact radius semantics on a sphere, index-backed, no separate search engine to operate.&lt;br&gt;Trade-off: dynamic SQL in one repository (whitelisted sort keys, bound parameters)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1030" height="220" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:14px'&gt;ADR-2 AI search produces filters, not results&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision: LLM converts text → the same SearchFilters the filter panel uses; normal search runs after.&lt;br&gt;Why: one search path, explainable &amp; editable chips, model output is sanitised (clamped, unknown enums dropped).&lt;br&gt;Trade-off: needs a deterministic RuleBasedQueryParser fallback for no-key / errors / refusals." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="1030" height="220" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:14px'&gt;ADR-3 Token storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision: access JWT in memory (15 min) + opaque refresh token in httpOnly cookie, rotated, stored as SHA-256.&lt;br&gt;Why: no tokens in localStorage (XSS-safe), theft detection via reuse → revoke family.&lt;br&gt;Trade-off: concurrent refresh from two tabs can log the user out (strict reuse detection)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1030" height="220" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:14px'&gt;ADR-4 Same-origin API via Next.js rewrites&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision: browser calls /api/* on the app origin; Next.js proxies to the backend.&lt;br&gt;Why: first-party cookie, no cross-site cookie/CORS complexity.&lt;br&gt;Trade-off: extra hop for API calls; WebSocket bypasses Next.js and goes Caddy → backend." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="350" width="1030" height="220" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:14px'&gt;ADR-5 Push after commit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision: services publish events; @TransactionalEventListener(AFTER_COMMIT) pushes over STOMP.&lt;br&gt;Why: clients never see data that was rolled back; services stay free of messaging code.&lt;br&gt;Trade-off: in-memory simple broker → single instance (swap for RabbitMQ relay to scale out)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1030" height="220" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:14px'&gt;ADR-6 Single visibility rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision: listing is public iff status=ACTIVE ∧ owner VERIFIED ∧ owner not suspended ∧ not soft-deleted, defined once in PropertyVisibility and reused by every public query.&lt;br&gt;Why: trust &amp; safety rule can't drift between endpoints." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="600" width="1030" height="220" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:14px'&gt;ADR-7 Package-by-feature monolith&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision: one Spring Boot app, packages per domain (auth, property, search, ai, visit, chat, …).&lt;br&gt;Why: simple to run on one 1 GB server; clear seams if a module is ever extracted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1030" height="220" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:14px'&gt;ADR-8 Free single-VM hosting&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision: Oracle Always Free E2.1.Micro + Docker Compose + Caddy; images built on the laptop and shipped over SSH.&lt;br&gt;Why: $0, always on, real HTTPS. Trade-off: 1 GB RAM → slow cold start, single point of failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="850" width="1030" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
