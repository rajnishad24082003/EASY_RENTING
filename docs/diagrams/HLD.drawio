ight="60" as="geometry"/></mxCell><mxCell id="c5" value="Search: city, locality autocomplete, rent range, BHK, type, furnishing, tenant preference, amenities, available-before" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="215" width="470" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Geo radius search (0.5–50 km) with distance sort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="285" width="470" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Map view with up to 500 pins, 'search this area'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="355" width="470" height="60" as="geometry"/></mxCell><mxCell id="c8" value="AI search: plain English → editable filter chips" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="425" width="470" height="60" as="geometry"/></mxCell><mxCell id="c9" value="Property detail: gallery, key facts, amenities, map, owner card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="495" width="470" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Register as Tenant or Owner; login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="565" width="470" height="60" as="geometry"/></mxCell><mxCell id