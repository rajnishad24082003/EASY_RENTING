# On your laptop: cp deploy/.env.production.example deploy/.env.production, then fill in.
# deploy/deploy.sh uses it for the build and copies it to the server. It's git-ignored. Never commit it.

# Public hostname. Without a domain, use your server's public IP with dashes + .sslip.io,
# e.g. IP 140.238.10.20  ->  140-238-10-20.sslip.io
SITE_HOST=140-238-10-20.sslip.io

# Must match SITE_HOST.
PUBLIC_APP_URL=https://140-238-10-20.sslip.io
PUBLIC_WS_URL=wss://140-238-10-20.sslip.io/ws
COOKIE_SECURE=true

# Generate each with: openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=

# "prod,demo" seeds the demo accounts and listings, which is what a showcase needs.
SPRING_PROFILES_ACTIVE=prod,demo

# Leave EMPTY. A Claude API key is billed per request, and anyone visiting the public site could run up
# charges. Empty = the free rule-based parser.
ANTHROPIC_API_KEY=
